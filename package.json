{
  "name": "amberg-live",
  "private": true,
  "description": "Frontend build tools only (Tailwind v3, vendored Leaflet). The server does not need Node.",
  "scripts": {
    "build:css": "tailwindcss -i app/static/src/app.css -o app/static/css/app.css --minify",
    "watch:css": "tailwindcss -i app/static/src/app.css -o app/static/css/app.css --watch",
    "vendor": "node scripts/copy-vendor.mjs",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "3.4"
  }
}
