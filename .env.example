# Copy to .env and fill in. Never commit .env.

# development | production | testing
APP_ENV=development

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Public base URL, used for sitemap, Open Graph and email links (no trailing slash)
SITE_URL=http://localhost:5000

# Empty = SQLite file in instance/. PostgreSQL example:
# DATABASE_URL=postgresql://amberg:password@localhost:5432/amberg_live
DATABASE_URL=

# Where uploaded images are stored (default: instance/uploads)
UPLOAD_FOLDER=
MAX_UPLOAD_MB=8

# Rate limit storage. memory:// is fine for one gunicorn worker; use redis:// for several.
RATELIMIT_STORAGE_URI=memory://

# Outgoing mail. Leave MAIL_HOST empty in development: mails are printed to the log instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=Amberg Live <noreply@example.com>

# Receives notifications about new submissions; also used by `flask seed` for the demo admin
ADMIN_EMAIL=admin@example.com

# Password for all demo accounts created by `flask seed` (development only)
SEED_PASSWORD=amberg-demo-2026

# Number of reverse proxies in front of the app (nginx = 1). Production default: 1
PROXY_COUNT=0

# Production: only answer for these host names (comma-separated), e.g. amberg-live.de,www.amberg-live.de
ALLOWED_HOSTS=

# Site-wide rate limit per IP (login/register/submit have stricter own limits)
RATELIMIT_DEFAULT=300 per minute

# Look up map coordinates for addresses via OpenStreetMap Nominatim (server-side)
GEOCODER_ENABLED=true

LOG_LEVEL=INFO
